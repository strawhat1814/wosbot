<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity"
      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="task-page-scroll"
                    vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="task-page-root" maxHeight="Infinity"
                      maxWidth="Infinity" spacing="14">
                    <children>

                        <!-- Chief Order (pre-Fire Crystal) -->
                        <VBox styleClass="content-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity"
                                      styleClass="header-yellow">
                                    <children>
                                        <Label text="Chief Order" />
                                    </children>
                                </HBox>
                                <VBox styleClass="task-section-inner">
                                    <children>
                                        <Label styleClass="task-card-description"
                                               text="Pre-Fire Crystal Chief House orders. Enable only the lineup your furnace still shows."
                                               wrapText="true" />

                                        <Separator style="-fx-opacity: 0.25;" />

                                        <VBox styleClass="task-subsection" spacing="14">
                                            <children>
                                                <CheckBox fx:id="checkBoxUrgentMobilisation" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Urgent Mobilization (every 8h)" />
                                                <CheckBox fx:id="checkBoxRushJob" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Rush Job (every 23h)" />
                                                <CheckBox fx:id="checkBoxDoubleTime" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Double Time (every 23h)" />
                                                <CheckBox fx:id="checkBoxProductivityDay" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Productivity Day (every 12h)" />
                                                <CheckBox fx:id="checkBoxFestivities" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Festivities (every 24h)" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- FC Chief Order -->
                        <VBox styleClass="content-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity"
                                      styleClass="header-yellow">
                                    <children>
                                        <Label text="FC Chief Order" />
                                    </children>
                                </HBox>
                                <VBox styleClass="task-section-inner">
                                    <children>
                                        <Label styleClass="task-card-description"
                                               text="Fire Crystal Age orders (Furnace FC1+). Rush Job and Double Time reuse the same templates as the classic lineup."
                                               wrapText="true" />

                                        <Separator style="-fx-opacity: 0.25;" />

                                        <VBox styleClass="task-subsection" spacing="14">
                                            <children>
                                                <CheckBox fx:id="checkBoxFcCrunchTime" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Crunch Time (every 12h)" />
                                                <CheckBox fx:id="checkBoxFcRushJob" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Rush Job (every 23h)" />
                                                <CheckBox fx:id="checkBoxFcDoubleTime" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Double Time (every 23h)" />
                                                <CheckBox fx:id="checkBoxFcDawnAllianceCommendation" mnemonicParsing="false"
                                                          graphicTextGap="3.0" text="Dawn Alliance Commendation (every 47h)" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
